{
  "aqp-session": {
    "SessionStart": [
      {
        "type": "command",
        "command": "python3 hooks/aqp_agy_hook.py start",
        "timeout": 30
      }
    ]
  },
  "aqp-guard": {
    "PreToolUse": [
      {
        "matcher": "edit_file|write_file|replace_file_content|multi_replace_file_content|write_to_file|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 hooks/aqp_agy_hook.py guard",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "aqp-format": {
    "PostToolUse": [
      {
        "matcher": "edit_file|write_file|replace_file_content|multi_replace_file_content|write_to_file",
        "hooks": [
          {
            "type": "command",
            "command": "python3 hooks/aqp_agy_hook.py format",
            "timeout": 60
          }
        ]
      }
    ]
  },
  "aqp-stop": {
    "Stop": [
      {
        "type": "command",
        "command": "python3 hooks/aqp_agy_hook.py stop",
        "timeout": 1800
      }
    ]
  }
}
