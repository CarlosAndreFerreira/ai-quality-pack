diff --git a/shop/pricing.py b/shop/pricing.py
index c14f223..bf4e5a4 100755
--- a/shop/pricing.py
+++ b/shop/pricing.py
@@ -1,5 +1,31 @@
-"""Price rounding."""
+"""Price rounding.
+
+Money rules: docs/SPEC.md. Numbers are read as written (via their shortest
+decimal repr), all money arithmetic is exact decimal, and rounding happens
+once, half away from zero, to two decimals.
+"""
+from decimal import ROUND_HALF_UP, Decimal, localcontext
+
+CENT = Decimal("0.01")
+
+# Wide enough that products of two float reprs are exact before rounding.
+_PREC = 200
+
+
+def to_decimal(value):
+    """Exact decimal value of a float/int/Decimal as written, e.g. 2.675 -> 2.675."""
+    if isinstance(value, Decimal):
+        return value
+    return Decimal(str(value))
+
+
+def round_decimal(value):
+    """Round an exact Decimal to two decimals, half away from zero."""
+    with localcontext() as ctx:
+        ctx.prec = _PREC
+        return value.quantize(CENT, rounding=ROUND_HALF_UP)
 
 
 def round_price(value):
-    return round(value, 2)
+    """Round a number to two decimals and return a float."""
+    return float(round_decimal(to_decimal(value)))
