diff --git a/shop/pricing.py b/shop/pricing.py
index c14f223..d8c7e07 100755
--- a/shop/pricing.py
+++ b/shop/pricing.py
@@ -1,5 +1,25 @@
-"""Price rounding."""
+"""Price rounding.
+
+Money follows docs/SPEC.md: a number means what it shows when printed, all
+arithmetic is exact decimal arithmetic, and rounding happens once, on the exact
+result, with half cents rounding away from zero.
+"""
+from decimal import ROUND_HALF_UP, Decimal
+
+CENT = Decimal("0.01")
+
+
+def to_dec(value):
+    """Exact decimal of a float/int as written (str gives the shortest printed form)."""
+    if isinstance(value, Decimal):
+        return value
+    return Decimal(str(value))
+
+
+def quantize_cent(value):
+    """Round an exact Decimal to two decimals, half away from zero."""
+    return to_dec(value).quantize(CENT, rounding=ROUND_HALF_UP)
 
 
 def round_price(value):
-    return round(value, 2)
+    return float(quantize_cent(value))
