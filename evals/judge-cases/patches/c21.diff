diff --git a/shop/pricing.py b/shop/pricing.py
index c14f223..126db29 100755
--- a/shop/pricing.py
+++ b/shop/pricing.py
@@ -1,5 +1,22 @@
-"""Price rounding."""
+"""Price rounding.
+
+Money rules: docs/SPEC.md. Numbers are read at the value they print as (repr),
+arithmetic is exact decimal, and rounding happens once, half away from zero.
+"""
+from decimal import Decimal, ROUND_HALF_UP
+
+CENT = Decimal("0.01")
+
+
+def to_decimal(value):
+    """Exact decimal for a number as written. A float is read via its shortest repr."""
+    if isinstance(value, Decimal):
+        return value
+    if isinstance(value, float):
+        return Decimal(repr(value))
+    return Decimal(value)
 
 
 def round_price(value):
-    return round(value, 2)
+    """Round a number to two decimals (half away from zero) and return a float."""
+    return float(to_decimal(value).quantize(CENT, rounding=ROUND_HALF_UP))
