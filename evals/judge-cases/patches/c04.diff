diff --git a/shop/pricing.py b/shop/pricing.py
index c14f223..b85e62d 100755
--- a/shop/pricing.py
+++ b/shop/pricing.py
@@ -1,5 +1,22 @@
-"""Price rounding."""
+"""Price rounding. Rules: docs/SPEC.md."""
+from decimal import Decimal, ROUND_HALF_UP
+
+CENT = Decimal("0.01")
+
+
+def to_decimal(value):
+    """Exact decimal of a number as written: a float means what its repr shows."""
+    if isinstance(value, Decimal):
+        return value
+    if isinstance(value, float):
+        return Decimal(repr(value))
+    return Decimal(value)
+
+
+def round_decimal(value):
+    """Round an exact Decimal to cents (half away from zero) and return a float."""
+    return float(value.quantize(CENT, rounding=ROUND_HALF_UP))
 
 
 def round_price(value):
-    return round(value, 2)
+    return round_decimal(to_decimal(value))
