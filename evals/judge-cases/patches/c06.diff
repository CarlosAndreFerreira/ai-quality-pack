+            raise ValueError("capacity must be > 0")
+        if refill_per_second < 0:
+            raise ValueError("refill_per_second must be >= 0")
+        self._capacity = float(capacity)
+        self._rate = float(refill_per_second)
+        self._clock = clock
+        self._lock = threading.Lock()
