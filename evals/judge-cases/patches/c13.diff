diff --git a/shop/pricing.py b/shop/pricing.py
index c14f223..a9154aa 100755
--- a/shop/pricing.py
+++ b/shop/pricing.py
@@ -1,5 +1,20 @@
-"""Price rounding."""
+"""Price rounding. Money rules: docs/SPEC.md."""
+from decimal import Decimal, ROUND_HALF_UP
+
+CENT = Decimal("0.01")
+
+
+def to_decimal(value):
+    """Exact decimal of a number as written (its shortest printed form, e.g. 2.675 -> 2.675)."""
+    if isinstance(value, Decimal):
+        return value
+    return Decimal(str(value))
+
+
+def round_decimal(value):
+    """Round an exact decimal to cents, half cent away from zero. Returns a float."""
+    return float(to_decimal(value).quantize(CENT, rounding=ROUND_HALF_UP))
 
 
 def round_price(value):
-    return round(value, 2)
+    return round_decimal(value)
