diff --git a/shop/pricing.py b/shop/pricing.py
index c14f223..38e5d3c 100755
--- a/shop/pricing.py
+++ b/shop/pricing.py
@@ -1,5 +1,18 @@
-"""Price rounding."""
+"""Price rounding. Rules: docs/SPEC.md."""
+from decimal import ROUND_HALF_UP, Decimal
+
+CENT = Decimal("0.01")
+
+
+def to_decimal(value):
+    """Exact decimal of a number as it is printed (2.675 -> 2.675, not the float's binary value)."""
+    return Decimal(str(value))
+
+
+def round_decimal(value):
+    """Round an exact Decimal to cents; a half cent rounds away from zero."""
+    return value.quantize(CENT, rounding=ROUND_HALF_UP)
 
 
 def round_price(value):
-    return round(value, 2)
+    return float(round_decimal(to_decimal(value)))
