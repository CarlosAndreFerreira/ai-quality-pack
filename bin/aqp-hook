#!/bin/sh
# Runs one of the pack's hooks from the plugin directory. Usage: aqp-hook start|format|guard|stop
# A project that has the pack's own install (install.py) keeps its hooks: aqp_hook.py then does nothing.
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
case "$1" in
  start|format|guard|stop) ;;
  *) echo "aqp-hook: unknown hook '$1' (use start, format, guard or stop)" >&2; exit 1 ;;
esac
# A name on PATH is not sufficient: on Windows, `python3` can be the Microsoft Store alias, which is found and does not run.
for py in python3 python; do
  if command -v "$py" >/dev/null 2>&1 && "$py" -c "import sys" >/dev/null 2>&1; then
    exec "$py" "$root/hooks/aqp_hook.py" "$@"
  fi
done
echo "aqp-hook: no python3 or python on PATH that runs" >&2
exit 1
